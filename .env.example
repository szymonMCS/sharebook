# ============================================
# SHAREBOOK - PLIK PRZYKŁADOWY .env.example
# Skopiuj ten plik do .env i uzupełnij wartości
# NIE COMMITUJ PLIKU .env DO GIT!
# ============================================

# --------------------------------------------
# BAZA DANYCH (PostgreSQL + pgvector)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5433/sharebook

# --------------------------------------------
# BEZPIECZEŃSTWO / JWT
# Wygeneruj silny klucz: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
DEBUG=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --------------------------------------------
# OPENAI API - WYMAGANY DO CHATBOTA RAG
# Pobierz klucz z: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Alternatywny provider AI (Moonshot)
MOONSHOT_API_KEY=sk-your-moonshot-api-key
BASE_URL=https://api.moonshot.ai/v1
MODEL=kimi-k2.5

# --------------------------------------------
# RAG / AI Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
KNOWLEDGE_BASE_PATH=data/knowledge_base.md

# --------------------------------------------
# FRONTEND (zmienne VITE_*)
# Port frontend dev server - Vite automatycznie użyje tego lub 5173
PORT=5173

# URL do backend API - frontend użyje tego lub domyślnie http://localhost:8000
VITE_API_URL=http://localhost:8000/api/v1

# URL frontend (dla CORS)
FRONTEND_URL=http://localhost:5173

